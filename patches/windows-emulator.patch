--- a/main.cpp
+++ b/main.cpp
@@ -11,6 +11,9 @@
 #include <QDebug>
 #include <QDateTime>
 #include <cstdio>
+#include <QSettings>
+#include <QDir>
+#include <QFontDatabase>
 
     ioMapData mpd;
 
@@ -21,6 +24,24 @@ int main(int argc, char *argv[])
     app.setOrganizationName("Power-Tune");
     app.setOrganizationDomain("power-tune.org");
     app.setApplicationName("PowerTune");
+#ifdef Q_OS_WIN
+    // EMULATOR: keep settings as .ini files like the dash's ~/.config/*.conf (not the registry),
+    // so the dash's real PowerTune.conf can be copied in, and load the dash's fonts from
+    // C:/PowerTune/fonts because they are installed system-wide on the dash.
+    QSettings::setDefaultFormat(QSettings::IniFormat);
+    for (const QFileInfo &f : QDir(ptBasePath() + "/fonts").entryInfoList({"*.ttf", "*.TTF", "*.otf"}, QDir::Files))
+        QFontDatabase::addApplicationFont(f.absoluteFilePath());
+    {   // EMULATOR: record which settings file is used, to C:/PowerTune/emulator.log
+        QSettings s;
+        QFile log(ptBasePath() + "/emulator.log");
+        if (log.open(QIODevice::WriteOnly | QIODevice::Text)) {
+            QTextStream(&log) << QDateTime::currentDateTime().toString(Qt::ISODate)
+                              << " settings=" << s.fileName() << " status=" << s.status()
+                              << " keys=" << s.allKeys().size()
+                              << " dashselect1=" << s.value("dashselect1").toString() << "\n";
+        }
+    }
+#endif
     QQmlApplicationEngine engine;
     qmlRegisterType<ioMapData>("IMD", 1, 0, "IMD");
     qmlRegisterType<DownloadManager>("DLM", 1, 0, "DLM");
