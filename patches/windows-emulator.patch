+// EMULATOR: QSettings(org, app) always uses the registry on Windows (setDefaultFormat doesn't
+// apply to that constructor), so name the INI format explicitly to read PowerTuneDash.ini like the dash.
+#ifdef Q_OS_WIN
+#define PT_DASH_SETTINGS QSettings::IniFormat, QSettings::UserScope, "PowerTuneQML", "PowerTuneDash"
+#else
+#define PT_DASH_SETTINGS "PowerTuneQML", "PowerTuneDash"
+#endif
+
 void AppSettings::setValue(const QString &key, const QVariant &value)
 {
-    QSettings settings("PowerTuneQML", "PowerTuneDash", this);
+    QSettings settings(PT_DASH_SETTINGS, this);
     settings.setValue(key, value);
 }
 
 QVariant AppSettings::getValue(const QString &key)
 {
-    QSettings settings("PowerTuneQML", "PowerTuneDash", this);
+    QSettings settings(PT_DASH_SETTINGS, this);
     return settings.value(key);
 }
